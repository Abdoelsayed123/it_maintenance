<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_it_maintenance" model="ir.module.category">
        <field name="name">IT Maintenance</field>
        <field name="description">Access to devices and maintenance requests.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_it_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_it_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees requests assigned to them or not assigned yet, and can work on them.</field>
    </record>

    <record id="group_it_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_it_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('group_it_technician'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sees all requests and devices, can delete them and access reporting.</field>
    </record>

    <data noupdate="1">

        <record id="it_request_rule_technician" model="ir.rule">
            <field name="name">Maintenance Request: technicians see their own and unassigned requests</field>
            <field name="model_id" ref="model_it_request"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_it_technician'))]"/>
        </record>

        <record id="it_request_rule_manager" model="ir.rule">
            <field name="name">Maintenance Request: managers see all requests</field>
            <field name="model_id" ref="model_it_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_it_manager'))]"/>
        </record>

        <record id="it_request_rule_company" model="ir.rule">
            <field name="name">Maintenance Request: multi-company</field>
            <field name="model_id" ref="model_it_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="it_device_rule_company" model="ir.rule">
            <field name="name">Device: multi-company</field>
            <field name="model_id" ref="model_it_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
