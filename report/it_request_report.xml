<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_request_report_action" model="ir.actions.report">
        <field name="name">Job Card</field>
        <field name="model">it.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_maintenance.it_request_report_job_card</field>
        <field name="report_file">it_maintenance.it_request_report_job_card</field>
        <field name="print_report_name">'Job Card - %s' % (object.reference or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_it_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="it_request_report_job_card_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
            <t t-set="address">
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
            </t>
            <div class="page">
                <h2>
                    Job Card <span t-field="o.reference"/>
                </h2>
                <h5 class="text-muted" t-field="o.name"/>

                <div class="row mt-4 mb-4">
                    <div class="col-3">
                        <strong>Device</strong>
                        <p class="m-0" t-field="o.device_id.name"/>
                        <p class="m-0 text-muted" t-field="o.device_id.serial_number"/>
                    </div>
                    <div class="col-3">
                        <strong>Type</strong>
                        <p class="m-0" t-field="o.request_type"/>
                    </div>
                    <div class="col-3">
                        <strong>Technician</strong>
                        <p class="m-0" t-field="o.user_id"/>
                    </div>
                    <div class="col-3">
                        <strong>Status</strong>
                        <p class="m-0" t-field="o.state"/>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-3">
                        <strong>Request Date</strong>
                        <p class="m-0" t-field="o.request_date"/>
                    </div>
                    <div class="col-3" t-if="o.deadline">
                        <strong>Deadline</strong>
                        <p class="m-0" t-field="o.deadline"/>
                    </div>
                    <div class="col-3" t-if="o.date_done">
                        <strong>Completed On</strong>
                        <p class="m-0" t-field="o.date_done"/>
                    </div>
                    <div class="col-3" t-if="o.device_id.warranty_state == 'active'">
                        <strong>Warranty</strong>
                        <p class="m-0">Under warranty until <span t-field="o.device_id.warranty_end_date"/></p>
                    </div>
                </div>

                <div t-if="o.description" class="mb-4">
                    <h5>Problem Description</h5>
                    <div t-field="o.description"/>
                </div>
                <div t-if="o.diagnosis" class="mb-4">
                    <h5>Technician Report</h5>
                    <div t-field="o.diagnosis"/>
                </div>

                <table class="table table-sm o_main_table" t-if="o.line_ids">
                    <thead>
                        <tr>
                            <th class="text-start">Spare Part</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.part_name"/></td>
                            <td class="text-end"><span t-field="line.qty"/></td>
                            <td class="text-end"><span t-field="line.unit_price"/></td>
                            <td class="text-end"><span t-field="line.subtotal"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Spare Parts</td>
                                <td class="text-end"><span t-field="o.parts_total"/></td>
                            </tr>
                            <tr>
                                <td>Labor<t t-if="o.labor_hours"> (<span t-field="o.labor_hours" t-options='{"widget": "float_time"}'/> h)</t></td>
                                <td class="text-end"><span t-field="o.labor_cost"/></td>
                            </tr>
                            <tr class="border-black o_total">
                                <td><strong>Total</strong></td>
                                <td class="text-end"><strong t-field="o.amount_total"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row mt-5">
                    <div class="col-6">
                        <p class="mb-5">Technician Signature</p>
                        <p>______________________________</p>
                    </div>
                    <div class="col-6">
                        <p class="mb-5">Customer Signature</p>
                        <p>______________________________</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="it_request_report_job_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="it_maintenance.it_request_report_job_card_document" t-lang="o.partner_id.lang or o.env.lang"/>
            </t>
        </t>
    </template>

</odoo>
