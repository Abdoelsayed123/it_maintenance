<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_request_report_action" model="ir.actions.report">
        <field name="name">Job Card</field>
        <field name="model">it.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_maintenance.it_request_report_job_card</field>
        <field name="report_file">it_maintenance.it_request_report_job_card</field>
        <field name="print_report_name">'Job Card - %s' % (object.reference or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_it_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="it_request_report_job_card_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
            <t t-set="brand" t-value="o.company_id.primary_color or '#0F7C8C'"/>
            <t t-set="state_color" t-value="{
                'new': '#3B82F6',
                'in_progress': '#F59E0B',
                'waiting_parts': '#F97316',
                'done': '#16A34A',
                'cancel': '#6B7280',
            }.get(o.state, '#6B7280')"/>
            <t t-set="label_style" t-value="'font-size: 10px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;'"/>
            <t t-set="section_style" t-value="'background-color: %s; color: #FFFFFF; padding: 6px 10px; font-size: 12px; font-weight: bold; letter-spacing: 0.5px;' % brand"/>

            <div class="page o_it_job_card" style="font-size: 12px; color: #1F2937;">

                <!-- Title bar -->
                <table class="table-borderless" style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
                    <tr>
                        <td style="vertical-align: bottom;">
                            <div t-attf-style="font-size: 11px; font-weight: bold; letter-spacing: 2px; color: {{ brand }};">MAINTENANCE JOB CARD</div>
                            <div style="font-size: 26px; font-weight: bold; line-height: 1.2;" t-field="o.reference"/>
                            <div dir="auto" style="font-size: 14px; color: #4B5563; margin-top: 2px; text-align: left;" t-field="o.name"/>
                        </td>
                        <td style="vertical-align: bottom; text-align: right; width: 35%;">
                            <span t-attf-style="display: inline-block; background-color: {{ state_color }}; color: #FFFFFF; padding: 5px 14px; border-radius: 12px; font-weight: bold; font-size: 12px;"
                                  t-field="o.state"/>
                            <div style="margin-top: 6px; color: #6B7280;">
                                Priority: <strong style="color: #1F2937;" t-field="o.priority"/>
                            </div>
                        </td>
                    </tr>
                </table>
                <div t-attf-style="height: 3px; background-color: {{ brand }}; margin-bottom: 18px;"/>

                <!-- Customer and device -->
                <table class="table-borderless" style="width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 16px;">
                    <tr>
                        <td style="width: 49%; vertical-align: top; border: 1px solid #E5E7EB; padding: 0;">
                            <div t-att-style="section_style">CUSTOMER</div>
                            <div style="padding: 10px;">
                                <div dir="auto" style="font-size: 14px; font-weight: bold; text-align: left;" t-field="o.partner_id.name"/>
                                <div t-if="o.partner_id.phone"><i class="fa fa-phone" style="width: 14px;"/> <span t-field="o.partner_id.phone"/></div>
                                <div t-if="o.partner_id.email"><i class="fa fa-envelope" style="width: 14px;"/> <span t-field="o.partner_id.email"/></div>
                                <div t-if="o.partner_id.city" dir="auto" style="text-align: left;"><i class="fa fa-map-marker" style="width: 14px;"/> <span t-field="o.partner_id.city"/></div>
                                <div t-if="not o.partner_id" style="color: #9CA3AF;">No customer</div>
                            </div>
                        </td>
                        <td style="width: 2%;"/>
                        <td style="width: 49%; vertical-align: top; border: 1px solid #E5E7EB; padding: 0;">
                            <div t-att-style="section_style">DEVICE</div>
                            <div style="padding: 10px;">
                                <div style="font-size: 14px; font-weight: bold;" t-field="o.device_id.name"/>
                                <table class="table-borderless" style="width: 100%; margin-top: 4px;">
                                    <tr>
                                        <td style="color: #6B7280; width: 40%;">Serial Number</td>
                                        <td style="font-family: monospace;"><span t-field="o.device_id.serial_number"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #6B7280;">Type</td>
                                        <td><span t-field="o.device_id.device_type"/></td>
                                    </tr>
                                    <tr t-if="o.device_id.location">
                                        <td style="color: #6B7280;">Location</td>
                                        <td dir="auto" style="text-align: left;"><span t-field="o.device_id.location"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #6B7280;">Warranty</td>
                                        <td>
                                            <t t-if="o.device_id.warranty_state == 'active'">
                                                <span style="color: #16A34A; font-weight: bold;">Active</span>
                                                until <span t-field="o.device_id.warranty_end_date"/>
                                            </t>
                                            <span t-elif="o.device_id.warranty_state == 'expired'" style="color: #DC2626;">
                                                Expired on <span t-field="o.device_id.warranty_end_date"/>
                                            </span>
                                            <span t-else="" style="color: #9CA3AF;">None</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Service details -->
                <table class="table-borderless" style="width: 100%; border-collapse: collapse; background-color: #F9FAFB; border: 1px solid #E5E7EB; margin-bottom: 16px;">
                    <tr>
                        <td style="padding: 10px; width: 20%;">
                            <div t-att-style="label_style">Type</div>
                            <div style="font-weight: bold;" t-field="o.request_type"/>
                        </td>
                        <td style="padding: 10px; width: 20%;">
                            <div t-att-style="label_style">Technician</div>
                            <div style="font-weight: bold;">
                                <span t-if="o.user_id" t-field="o.user_id"/>
                                <span t-else="" style="color: #9CA3AF;">Not assigned</span>
                            </div>
                        </td>
                        <td style="padding: 10px; width: 20%;">
                            <div t-att-style="label_style">Request Date</div>
                            <div style="font-weight: bold;" t-field="o.request_date"/>
                        </td>
                        <td style="padding: 10px; width: 20%;">
                            <div t-att-style="label_style">Deadline</div>
                            <div style="font-weight: bold;">
                                <span t-if="o.deadline" t-field="o.deadline"/>
                                <span t-else="" style="color: #9CA3AF;">-</span>
                            </div>
                        </td>
                        <td style="padding: 10px; width: 20%;">
                            <div t-att-style="label_style">Completed On</div>
                            <div style="font-weight: bold;">
                                <span t-if="o.date_done" t-field="o.date_done" t-options='{"widget": "date"}'/>
                                <span t-else="" style="color: #9CA3AF;">-</span>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Problem and technician report -->
                <div t-if="o.description" style="margin-bottom: 14px; page-break-inside: avoid;">
                    <div t-att-style="section_style">PROBLEM DESCRIPTION</div>
                    <div dir="auto" style="padding: 10px; border: 1px solid #E5E7EB; border-top: none;" t-field="o.description"/>
                </div>
                <div t-if="o.diagnosis" style="margin-bottom: 14px; page-break-inside: avoid;">
                    <div t-att-style="section_style">TECHNICIAN REPORT</div>
                    <div dir="auto" style="padding: 10px; border: 1px solid #E5E7EB; border-top: none;" t-field="o.diagnosis"/>
                </div>

                <!-- Spare parts -->
                <div style="margin-bottom: 4px;">
                    <div t-att-style="section_style">SPARE PARTS &amp; LABOR</div>
                </div>
                <table class="table-borderless" style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                    <thead>
                        <tr style="background-color: #F3F4F6; border-bottom: 2px solid #D1D5DB;">
                            <th style="padding: 7px 8px; text-align: left; width: 5%;">#</th>
                            <th style="padding: 7px 8px; text-align: left;">Description</th>
                            <th style="padding: 7px 8px; text-align: right; width: 12%;">Qty</th>
                            <th style="padding: 7px 8px; text-align: right; width: 18%;">Unit Price</th>
                            <th style="padding: 7px 8px; text-align: right; width: 18%;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line"
                            t-attf-style="border-bottom: 1px solid #E5E7EB; {{ 'background-color: #FAFAFA;' if line_odd else '' }}">
                            <td style="padding: 7px 8px; color: #6B7280;" t-out="line_index + 1"/>
                            <td style="padding: 7px 8px; text-align: left;" dir="auto"><span t-field="line.part_name"/></td>
                            <td style="padding: 7px 8px; text-align: right;"><span t-field="line.qty"/></td>
                            <td style="padding: 7px 8px; text-align: right;"><span t-field="line.unit_price"/></td>
                            <td style="padding: 7px 8px; text-align: right;"><span t-field="line.subtotal"/></td>
                        </tr>
                        <tr t-if="o.labor_cost or o.labor_hours" style="border-bottom: 1px solid #E5E7EB;">
                            <td style="padding: 7px 8px; color: #6B7280;"><i class="fa fa-wrench"/></td>
                            <td style="padding: 7px 8px;">Labor</td>
                            <td style="padding: 7px 8px; text-align: right;">
                                <span t-if="o.labor_hours" t-field="o.labor_hours" t-options='{"widget": "float_time"}'/>
                                <span t-if="o.labor_hours"> h</span>
                            </td>
                            <td style="padding: 7px 8px;"/>
                            <td style="padding: 7px 8px; text-align: right;"><span t-field="o.labor_cost"/></td>
                        </tr>
                        <tr t-if="not o.line_ids and not o.labor_cost">
                            <td colspan="5" style="padding: 12px 8px; text-align: center; color: #9CA3AF;">No spare parts or labor recorded.</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals -->
                <table class="table-borderless" style="width: 100%; border-collapse: collapse; margin-bottom: 30px; page-break-inside: avoid;">
                    <tr>
                        <td style="width: 58%;"/>
                        <td style="width: 42%;">
                            <table class="table-borderless" style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="padding: 5px 8px; color: #6B7280;">Spare Parts</td>
                                    <td style="padding: 5px 8px; text-align: right;"><span t-field="o.parts_total"/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid #E5E7EB;">
                                    <td style="padding: 5px 8px; color: #6B7280;">Labor</td>
                                    <td style="padding: 5px 8px; text-align: right;"><span t-field="o.labor_cost"/></td>
                                </tr>
                                <tr t-attf-style="background-color: {{ brand }}; color: #FFFFFF;">
                                    <td style="padding: 8px; font-weight: bold; font-size: 14px;">TOTAL</td>
                                    <td style="padding: 8px; text-align: right; font-weight: bold; font-size: 14px;"><span t-field="o.amount_total"/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Signatures -->
                <table class="table-borderless" style="width: 100%; border-collapse: collapse; page-break-inside: avoid;">
                    <tr>
                        <td style="width: 45%; vertical-align: top;">
                            <div t-att-style="label_style">Technician</div>
                            <div style="height: 45px; border-bottom: 1px solid #9CA3AF;"/>
                            <div style="margin-top: 4px; color: #6B7280;">
                                <span t-if="o.user_id" t-field="o.user_id"/> · Date: ____________
                            </div>
                        </td>
                        <td style="width: 10%;"/>
                        <td style="width: 45%; vertical-align: top;">
                            <div t-att-style="label_style">Customer</div>
                            <div style="height: 45px; border-bottom: 1px solid #9CA3AF;"/>
                            <div style="margin-top: 4px; color: #6B7280;">Name &amp; Signature · Date: ____________</div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="it_request_report_job_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="it_maintenance.it_request_report_job_card_document" t-lang="o.partner_id.lang or o.env.lang"/>
            </t>
        </t>
    </template>

</odoo>
