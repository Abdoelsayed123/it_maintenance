<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_request_view_tree" model="ir.ui.view">
        <field name="name">it.request.tree</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Requests" sample="1" multi_edit="1"
                  decoration-muted="state == 'cancel'" decoration-danger="is_overdue">
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="reference" decoration-bf="1" readonly="1"/>
                <field name="name"/>
                <field name="device_id"/>
                <field name="partner_id" optional="show"/>
                <field name="request_type" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="request_date" optional="show"/>
                <field name="deadline" optional="show"
                       widget="remaining_days" attrs="{'invisible': [('state', 'in', ('done', 'cancel'))]}"/>
                <field name="amount_total" sum="Total" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="is_overdue" invisible="1"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('in_progress', 'waiting_parts')"
                       decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="it_request_view_form" model="ir.ui.view">
        <field name="name">it.request.form</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_start" string="Start Work" type="object" class="oe_highlight"
                            states="new"/>
                    <button name="action_start" string="Resume Work" type="object" class="oe_highlight"
                            states="waiting_parts"/>
                    <button name="action_wait_parts" string="Waiting for Parts" type="object"
                            states="in_progress"/>
                    <button name="action_done" string="Mark as Done" type="object" class="oe_highlight"
                            states="in_progress"/>
                    <button name="%(it_maintenance.it_request_report_action)d" string="Print Job Card" type="action"
                            states="in_progress,waiting_parts,done"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="new,in_progress,waiting_parts"
                            confirm="Are you sure you want to cancel this request?"/>
                    <button name="action_reset_to_new" string="Reset to New" type="object" states="cancel"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,waiting_parts,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger"
                            attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    <widget name="web_ribbon" title="Overdue" bg_color="bg-warning"
                            attrs="{'invisible': [('is_overdue', '=', False)]}"/>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2>
                            <field name="priority" widget="priority" class="me-3"/>
                            <field name="name" default_focus="1" placeholder="e.g. Screen flickers when opened"
                                   attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Device &amp; Customer">
                            <field name="device_id" options="{'no_quick_create': True}"
                                   attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}"/>
                            <field name="device_type"/>
                            <field name="partner_id"/>
                            <field name="request_type"/>
                        </group>
                        <group string="Planning">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="request_date"/>
                            <field name="deadline"/>
                            <field name="date_start" attrs="{'invisible': [('date_start', '=', False)]}"/>
                            <field name="date_done" attrs="{'invisible': [('date_done', '=', False)]}"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problem Description" name="description">
                            <field name="description" placeholder="What is the customer reporting? When did it start?"/>
                        </page>
                        <page string="Spare Parts &amp; Costs" name="parts">
                            <field name="line_ids" attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="part_name"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group>
                                <group>
                                    <field name="labor_hours" widget="float_time"
                                           attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}"/>
                                </group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="parts_total"/>
                                    <field name="labor_cost"
                                           attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="Technician Report" name="diagnosis">
                            <field name="diagnosis" placeholder="Root cause, work done and recommendations for the customer..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="it_request_view_kanban" model="ir.ui.view">
        <field name="name">it.request.kanban</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false"
                    records_draggable="false" sample="1">
                <field name="color"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <field name="currency_id"/>
                <field name="activity_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="{{!selection_mode ? kanban_color(record.color.raw_value) : ''}} oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                        <div class="text-muted"><field name="reference"/></div>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" t-if="!selection_mode">
                                        <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown"
                                           href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            <ul class="oe_kanban_colorpicker" data-field="color"/>
                                        </div>
                                    </div>
                                </div>
                                <div><field name="device_id"/></div>
                                <div class="text-muted"><field name="partner_id"/></div>
                                <div t-if="record.deadline.raw_value" t-attf-class="#{record.is_overdue.raw_value ? 'text-danger' : ''}">
                                    <i class="fa fa-clock-o" title="Deadline"/> <field name="deadline"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="amount_total" widget="monetary" class="me-2"/>
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="it_request_view_calendar" model="ir.ui.view">
        <field name="name">it.request.calendar</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance Requests" date_start="request_date" date_stop="deadline"
                      color="user_id" mode="month" event_open_popup="true" quick_add="false">
                <field name="device_id"/>
                <field name="partner_id"/>
                <field name="user_id" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="it_request_view_pivot" model="ir.ui.view">
        <field name="name">it.request.pivot</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Analysis" sample="1">
                <field name="user_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="it_request_view_graph" model="ir.ui.view">
        <field name="name">it.request.graph</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Analysis" type="bar" sample="1">
                <field name="request_date" interval="month"/>
                <field name="request_type"/>
            </graph>
        </field>
    </record>

    <record id="it_request_view_search" model="ir.ui.view">
        <field name="name">it.request.search</field>
        <field name="model">it.request</field>
        <field name="arch" type="xml">
            <search string="Maintenance Requests">
                <field name="name" string="Request"
                       filter_domain="['|', ('reference', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="device_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter string="My Requests" name="my_requests" domain="[('user_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter string="Open" name="open" domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Waiting for Parts" name="waiting_parts" domain="[('state', '=', 'waiting_parts')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', '3')]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <filter string="Request Date" name="filter_request_date" date="request_date"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Technician" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Device" name="group_device" context="{'group_by': 'device_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Request Date" name="group_request_date" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="it_request_action" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">it.request</field>
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="it_request_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first maintenance request</p>
            <p>Track every repair from the customer's call to the finished job card.</p>
        </field>
    </record>

    <record id="it_request_action_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">it.request</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="it_request_view_search"/>
        <field name="context">{'search_default_my_requests': 1, 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open requests assigned to you</p>
            <p>Requests you start or that a manager assigns to you appear here.</p>
        </field>
    </record>

    <record id="it_request_action_analysis" model="ir.actions.act_window">
        <field name="name">Maintenance Analysis</field>
        <field name="res_model">it.request</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="it_request_view_search"/>
    </record>

</odoo>
